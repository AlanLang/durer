{
  "name": "durerjs",
  "version": "0.1.0",
  "description": "AI 写的讲解型 HTML 的运行时：一个 <script> 引入，页面里就能放可编辑的 React 演示、retikz 图和悬浮解释",
  "type": "module",
  "license": "MIT",
  "types": "./dist/durer.d.ts",
  "exports": {
    "./lint": {
      "types": "./dist/lint.d.ts",
      "default": "./dist/lint.js"
    },
    "./package.json": "./package.json",
    "./dist/*": "./dist/*"
  },
  "files": [
    "dist",
    "!dist/lint-cli.js"
  ],
  "scripts": {
    "dev": "rsbuild dev",
    "build": "rsbuild build && bun run build:lint && bun run build:types && node scripts/sync-skill.mjs",
    "build:lint": "bun build src/lint/index.ts --target node --format esm --outfile dist/lint.js && bun build src/lint/cli.ts --target node --format esm --outfile dist/lint-cli.js",
    "build:types": "rollup -c rollup.dts.config.mjs && node scripts/prepend-authoring.mjs",
    "build:site": "node scripts/build-site.mjs",
    "test": "bun test",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "type:check": "tsc --noEmit",
    "check": "bun run lint && bun run type:check && bun run test && bun run build",
    "prepublishOnly": "bun run check",
    "prepare": "husky"
  },
  "dependencies": {},
  "devDependencies": {
    "@biomejs/biome": "^2.3.0",
    "@codemirror/lang-css": "6.3.1",
    "@codemirror/lang-html": "6.4.12",
    "@codemirror/lang-javascript": "6.2.5",
    "@codemirror/lang-json": "6.0.2",
    "@codemirror/language": "6.13.1",
    "@codemirror/legacy-modes": "6.5.5",
    "@floating-ui/dom": "1.8.0",
    "@happy-dom/global-registrator": "^20.13.2",
    "@lezer/highlight": "^1.2.1",
    "@retikz/core": "0.4.0",
    "@retikz/react": "0.4.0",
    "@retikz/render": "0.4.0",
    "@rsbuild/core": "^1.5.0",
    "@rsbuild/plugin-react": "^1.4.0",
    "@types/bun": "^1.2.0",
    "@types/katex": "^0.16.8",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "codemirror": "6.0.2",
    "husky": "^9.1.7",
    "katex": "0.19.1",
    "lint-staged": "^16.1.0",
    "parse5": "^8.0.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "rollup": "^4.63.1",
    "rollup-plugin-dts": "^6.5.1",
    "sucrase": "3.35.1",
    "typescript": "5.9.3"
  },
  "lint-staged": {
    "*.{ts,tsx,js,mjs,json,css,html}": "biome check --write --no-errors-on-unmatched"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AlanLang/durer.git"
  },
  "homepage": "https://alanlang.github.io/durer/"
}
